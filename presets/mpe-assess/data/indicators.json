  "key_lifecycle": [
    {
      "stage": "产生",
      "requirement": "密钥在符合 GB/T 37092 的密码产品中产生是十分必要的；同时可记录密钥关联信息（种类、长度、拥有者、使用起止时间）"
    },
    {
      "stage": "分发",
      "requirement": "抗截取、篡改、假冒；保证密钥机密性、完整性及分发者/接收者身份真实性"
    },
    {
      "stage": "存储",
      "requirement": "密钥不以明文方式存储在密码产品外部是十分必要的；公钥例外，可明文存储传递使用，但需防非授权篡改"
    },
    {
      "stage": "使用",
      "requirement": "每个密钥一般只有单一用途；使用前获授权；用公钥证书前验有效性；设定更换周期"
    },
    {
      "stage": "更新",
      "requirement": "超期、已泄露或存在泄露风险时按更新策略更新"
    },
    {
      "stage": "归档",
      "requirement": "归档密钥只能用于解密历史信息或验证历史签名；应生成审计信息（归档密钥、时间）"
    },
    {
      "stage": "撤销",
      "requirement": "一般针对公钥证书对应的密钥；证书到期自然撤销；撤销后不再具备使用效力"
    },
    {
      "stage": "备份",
      "requirement": "保证备份密钥的机密性和完整性；应生成审计信息（备份主体、时间）"
    },
    {
      "stage": "恢复",
      "requirement": "可支持用户密钥恢复和司法密钥恢复；应生成审计信息（恢复主体、时间）"
    },
    {
      "stage": "销毁",
      "requirement": "销毁过程不可逆，无法从销毁结果中恢复原密钥"
    }
  ],
  "key_lifecycle_note": "附录 B 为资料性附录（建议性），但 6.7b/7.7b/8.7b/9.7b「应根据密码应用方案，确定系统涉及的密钥种类、体系及其生存周期环节」本身是强制的——方案里没有密钥体系章节即建设运行层面直接失分。",
