  "general_requirements": {
    "chapter": "第 5 章",
    "applicability": "第一级到第五级全适用",
    "items": [
      {
        "item": "a",
        "text": "信息系统中使用的密码算法应符合法律、法规的规定和密码相关国家标准、行业标准的有关要求"
      },
      {
        "item": "b",
        "text": "信息系统中使用的密码技术应遵循密码相关国家标准和行业标准"
      },
      {
        "item": "c",
        "text": "信息系统中使用的密码产品、密码服务应符合法律法规的相关要求"
      }
    ],
    "note": "通用要求是全局前置条件：算法不合规，后面所有技术指标都无从谈起。"
  },
