    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-jobs-local": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.2-alpha.3",
