  "overrides": {
    "node-pty": "1.2.0-beta.15",
    "dsh-model-failover": {
      "@deepseek-ai/dsh-agent": "$@deepseek-ai/dsh-agent",
      "@deepseek-ai/dsh-llm": "$@deepseek-ai/dsh-llm",
      "@deepseek-ai/dsh-session": "$@deepseek-ai/dsh-session",
      "@deepseek-ai/dsh-skill": "$@deepseek-ai/dsh-skill"
    }
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
