{
  "name": "kingcode",
  "version": "0.1.0",
  "description": "KingCode —— 基于 DeepSeek Harness 的编程智能体（一次性任务 CLI）",
  "type": "module",
  "private": true,
  "bin": {
    "kingcode": "./bin/kingcode.js"
  },
  "files": [
    "bin",
    "plugins",
    "cordis.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/test-runner.js && node test/test-progress.js && node test/test-multi-edit.js && node test/test-prompt-sections.js && node test/test-env-context.js && node test/test-web-brand.js && node test/test-composition-refs.js && node test/test-guards.js && node test/test-command-guard.js && node test/test-mcp-echo-server.js",
    "check:contrast": "node web-brand/tools/check-contrast.js",
    "smoke": "node bin/kingcode.js \"say hi\"",
    "eval": "node eval/run.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
